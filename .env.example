# Local SQLite database (default zero-config; switchable to Turso / PostgreSQL in production)
DATABASE_URL="file:./data/omnigraph.db"

# Optional AI Socratic Tutor credentials (OpenAI-compatible or Google Gemini)
# If omitted, OmniGraph K12 automatically uses its built-in KG-grounded Socratic Pedagogical Engine!
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
