# Database URL:
# - Local default: file:./data/omnigraph.db
# - Vercel zero-config demo fallback: automatically uses file:/tmp/omnigraph.db when omitted
# - Production persistent Turso LibSQL: libsql://your-db-name.turso.io
DATABASE_URL=""
DATABASE_AUTH_TOKEN=""

# HMAC Session Signing & PIN Pepper Secret ( >= 16 chars recommended in production )
AUTH_SECRET=""

# Optional Admin Token to allow full database re-seed via maintenance API
ADMIN_RESET_TOKEN=""

# Optional Multimodal Vision OCR & Streaming Socratic Tutor credentials
# Supports Google Gemini, OpenAI-compatible, or Vercel AI Gateway!
# If omitted, OmniGraph K12 gracefully degrades to its deterministic KG Socratic Coach & Local Demo OCR.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

AI_GATEWAY_API_KEY=""
