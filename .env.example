# Database URL:
# - Local default: file:./data/omnigraph.db
# - Vercel zero-config demo fallback: automatically uses file:/tmp/omnigraph.db when omitted
# - Production persistent Turso LibSQL: libsql://your-db-name.turso.io
DATABASE_URL=""
DATABASE_AUTH_TOKEN=""

# Optional AI Socratic Tutor credentials (OpenAI-compatible or Google Gemini)
# If omitted, OmniGraph K12 automatically uses its built-in KG-grounded Socratic Pedagogical Engine!
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
